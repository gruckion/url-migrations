{
  "name": "url-migrations",
  "version": "0.1.0",
  "description": "Declarative URL migrations: turn old bookmarked URLs into current ones with ordered, idempotent rules.",
  "license": "MIT",
  "author": "Stephen Rayner",
  "repository": "github:gruckion/url-migrations",
  "keywords": ["url", "search-params", "migration", "redirect", "nextjs", "middleware", "nuqs"],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
