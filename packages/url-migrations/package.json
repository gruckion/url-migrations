{
  "name": "url-migrations",
  "version": "0.1.0",
  "description": "Declarative URL migrations: turn old bookmarked URLs into current ones with ordered, idempotent rules.",
  "license": "MIT",
  "author": "Stephen Rayner",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gruckion/url-migrations.git",
    "directory": "packages/url-migrations"
  },
  "keywords": [
    "url",
    "search-params",
    "migration",
    "redirect",
    "nextjs",
    "middleware",
    "nuqs"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./contract": {
      "import": {
        "types": "./dist/contract.d.ts",
        "default": "./dist/contract.js"
      },
      "require": {
        "types": "./dist/contract.d.cts",
        "default": "./dist/contract.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "bin": {
    "url-migrations": "./dist/cli.js"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  }
}
